{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "node ./check-parcel-collisions.js && sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "install-sdk": "npm i @dcl/sdk@latest --workspaces",
    "export-static": "sdk-commands export-static",
    "check-parcels": "node ./check-parcel-collisions.js"
  },
  "devDependencies": {
    "@dcl/asset-packs": "latest",
    "@dcl/js-runtime": "latest",
    "@dcl/sdk": "^7.24.4",
    "glob": "=13.0.6"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "workspaces": [
    ".",
    "scenes/*"
  ]
}
